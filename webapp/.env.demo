# Training / demo build — runs entirely on in-memory sample data.
# Loaded by `vite --mode demo` (npm run dev:demo / build:demo).
#
# VITE_DEMO=true forces demo mode no matter what, so the real backend is never
# used. The Supabase vars are left blank on purpose: deploy the demo site from a
# build that has NO Supabase env set (e.g. a separate Cloudflare Pages project
# with no variables), and the bundle ships with zero real credentials — real
# papers are unreachable from the training site by construction.
VITE_DEMO=true
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
